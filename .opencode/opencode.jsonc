{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "api": "https://api.opencode.ai/v1",
      "npm": "@ai-sdk/openai-compatible",
      "apiKey": "sk-vIwnWZT7NyuZAQotnmaf6jVSsfh0KU1sJazu3ED1oo3zZftLZ7icioDDoDW0wyEA",
      "models": {
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "tool_call": true
        }
      }
    }
  },
  "permission": {
    "external_directory": "allow"
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {
    "presentation": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-presentation/index.ts"],
      "enabled": true
    },
    "s3-storage": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-s3-storage/index.ts"],
      "enabled": true
    },
    "zulip": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-zulip/index.ts"],
      "enabled": true
    },
    "ragflow-proxy": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-ragflow-proxy/index.ts"],
      "enabled": true
    },
    "bot-factory": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-bot-factory/index.ts"],
      "enabled": true
    },
    "tables": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-tables/index.ts"],
      "enabled": true
    },
    "media": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-media/index.ts"],
      "enabled": true
    },
    "web-search": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-web-search/index.ts"],
      "enabled": true
    },
    "zulip-messages": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-zulip-messages/index.ts"],
      "enabled": true
    },
    "deep-research": {
      "type": "local",
      "command": ["bun", "run", "/legion/.legion/mcp-deep-research/index.ts"],
      "enabled": true
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
