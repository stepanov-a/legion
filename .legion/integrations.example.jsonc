{
  "sources": [
    {
      "name": "zulip",
      "type": "webhook",
      "endpoint": "POST /webhook/zulip",
      "zulip_url": "https://localhost:8443",
      "commands_dir": ".legion/command",
      "tokens": {
        "bashkati4-bot@zulip.local": "CHANGE_ME",
        "adminbotv2-bot@zulip.local": "CHANGE_ME"
      },
      "bot_api_keys": {
        "bashkati4-bot@zulip.local": "CHANGE_ME",
        "adminbotv2-bot@zulip.local": "CHANGE_ME"
      },
      "s3": {
        "bucket": "legion-bots",
        "prefix": "bot-files",
        "region": "us-east-1",
        "endpoint": "http://localhost:9000"
      },
      "routing": [
        { "stream": "deep-research", "command": "deep-research" },
        { "stream": "admin",         "command": "admin" },
        { "stream": "general",       "command": "bashkati4" },
        { "stream": "*",             "command": "bashkati4" }
      ]
    }
  ],
  "default_command": "bashkati4"
}
