{
  // Routing для входящих вебхуков.
  // Токены больше не здесь — они в S3 per-bot конфигах (bot-prompts/{name}/config.json).
  // Подробнее: .legion/integrations.md
  "sources": [
    {
      "name": "zulip",
      "type": "webhook",
      "endpoint": "POST /webhook/zulip",
      "zulip_url": "https://legion.zulip.local:8443",
      "commands_dir": ".legion/command",
      "tokens": {},
      "bot_api_keys": {},
      "s3": {
        "bucket": "legion-bots",
        "prefix": "bot-files",
        "region": "us-east-1",
        "endpoint": "http://localhost:9000"
      },
      "routing": [
        { "stream": "admin",          "command": "admin" },
        { "field": "bot_email", "bot_email": "adminbotv2-bot@zulip.local", "command": "admin" },
        { "stream": "*",              "command": "bashkati4" }
      ]
    }
  ],
  "default_command": "bashkati4"
}
