{
  // Реестр ботов Legion.
  // Синхронизируется в S3: bot-prompts/{name}/config.json
  // Подробнее: .legion/integrations.md
  "bots": [
    {
      "name": "example-bot",
      "description": "Пример бота",
      "agent": "general",
      "stream": "example-stream",
      "model": "opencode-go/deepseek-v4-flash",
      "mcp": { "zulip": true },
      "allow": ["user@example.com"],
      "zulip_email": "examplebot-bot@zulip.local",
      "zulip_api_key": "CHANGE_ME",
      "zulip_user_id": 0,
      "service_tokens": ["CHANGE_ME"]
    }
  ]
}
