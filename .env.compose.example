# Legion — переменные для compose-сплита.
# Скопируй в .env рядом с legion.compose.yml / zulip.compose.yml и заполни.
# .env в git не попадает (см. .gitignore). Здесь только имена и заглушки.

# --- Обязательные (compose упадёт с ошибкой, если не заданы) ---
# Ключ RAGFlow API (вид: ragflow-XXXX)
RAGFLOW_TOKEN=
# S3/MinIO креды (хранилище файлов ботов)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Пароль HTTP-сервера opencode (serve --port 3000)
OPENCODE_SERVER_PASSWORD=

# --- Необязательные: есть значения по умолчанию в compose ---
# Куда legion ходит за Zulip API
ZULIP_URL=https://legion-zulip-1:443
# Эндпоинты хранилищ на хосте
S3_ENDPOINT=http://host.docker.internal:59000
S3_BUCKET=legion-bots
RAGFLOW_API=http://host.docker.internal:59380
# Модель по умолчанию для агента (provider/model-id)
DEFAULT_MODEL=nti/deepseek-v4-flash
# Доверенные адреса балансировщика для zulip (zulip.compose.yml)
LOADBALANCER_IPS=172.18.0.0/16
# 0 = TLS-проверка отключена (ТЕХДОЛГ, см. комментарий в legion.compose.yml)
NODE_TLS_REJECT_UNAUTHORIZED=0

# --- Ключи провайдеров для .opencode/opencode.jsonc ---
# Подставляются загрузчиком конфига через {env:NAME}; нужны процессу opencode,
# а не docker-интерполяции. Задаются в окружении контейнера legion
# (env_file: .env подхватывает их автоматически).
DEEPSEEK_API_KEY=
NTI_API_KEY=
