# ── RagFlow env vars ────────────────────────────────────────────
MYSQL_PASSWORD=infini_rag_flow
REDIS_PASSWORD=infini_rag_flow
ELASTIC_PASSWORD=infini_rag_flow
STACK_VERSION=8.11.3
ES_PORT=1200

# TEI embedding (not used)
TEI_IMAGE_CPU=infiniflow/text-embeddings-inference:cpu-1.8
TEI_IMAGE_GPU=infiniflow/text-embeddings-inference:1.8
TEI_MODEL=Qwen/Qwen3-Embedding-0.6B
TEI_PORT=6380
EMBEDDING_BATCH_SIZE=16

# MinIO — using our MinIO (not RagFlow's)
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

RAGFLOW_IMAGE=infiniflow/ragflow:latest
SVR_HTTP_PORT=9380
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382
MEM_LIMIT=4000000000
