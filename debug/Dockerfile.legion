FROM oven/bun:1.3

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    python3-openpyxl python3-pil \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages PyPDF2 python-pptx 2>&1 | tail -3

RUN mkdir -p /legion && chown 1000:1000 /legion
WORKDIR /legion

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile 2>&1 | tail -5
RUN bun run --cwd packages/opencode build 2>&1 | tail -5

COPY . .

CMD ["bun", "run", "./packages/opencode/src/index.ts", "serve", "--port", "3000", "--hostname", "0.0.0.0"]
