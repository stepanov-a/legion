# ── Конфигурация для развёртывания Legion ────────────────────────
# Скопируй в .env и заполни:
#   cp .env.example .env
#   bash debug/bootstrap.sh
#
# Большинство переменных переопределены в docker-compose.yml
# и не требуют правки. Ниже — только то, что нужно задать вручную.

# ── Администратор Zulip ──────────────────────────────────────────
ZULIP_ADMIN_EMAIL=a.stepanov@2035.university
ZULIP_ADMIN_PASSWORD=legion-admin-2025
# ZULIP_ADMIN_API_KEY — заполняется bootstrap.sh автоматически

# ── Для MCP-серверов (наследуются от родительского процесса) ─────
ZULIP_URL=https://zulip
ZULIP_EMAIL=a.stepanov@2035.university
# ZULIP_API_KEY — заполняется bootstrap.sh автоматически
ZULIP_API_HOST=legion.zulip.local:8443

# ── S3 (MinIO) для MCP-серверов ──────────────────────────────────
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=legion-bots

# ── URL для вебхуков новых ботов ─────────────────────────────────
LEGION_PAYLOAD_URL=http://legion.local:3000/webhook/zulip
