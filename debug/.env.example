# ── Legion инфраструктура ─────────────────────────────────────────
# Скопируй в .env и заполни:
#   cp .env.example .env
#   docker compose up -d
#   export $(grep -v '^#' .env | xargs)
#   bun run legion

# ── Обязательные для Legion (на хосте) ────────────────────────────
LEGION_PROJECT_DIR=/home/neo/Projects/legion_new/legion
LEGION_ZULIP_URL=https://zulip.local:8443

# ── Zulip (admin) ─────────────────────────────────────────────────
ZULIP_ADMIN_EMAIL=a.stepanov@2035.university
ZULIP_ADMIN_PASSWORD=legion-admin-2025
# Получить: curl -sk https://localhost:8443/api/v1/fetch_api_key \
#   -d "username=$ZULIP_ADMIN_EMAIL" -d "password=$ZULIP_ADMIN_PASSWORD"
ZULIP_ADMIN_API_KEY=bgLybnJfLsIr8WXyAnGuiPJVbVjViX04

# ── Для MCP-сервера zulip (наследуется от родительского процесса) ─
ZULIP_URL=https://zulip.local:8443
ZULIP_EMAIL=a.stepanov@2035.university
ZULIP_API_KEY=bgLybnJfLsIr8WXyAnGuiPJVbVjViX04
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── MinIO / S3 ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Для MCP-сервера s3-storage (наследуется от родительского процесса)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=legion-bots

# ── RAGFlow (опционально, для фоновой индексации файлов) ─────────
RAGFLOW_API=http://127.0.0.1:9380
RAGFLOW_TOKEN=ragflow-RiMTA5NmRlYWRkYjExZjBiYWVmNWVhOD
