# ── Конфигурация Legion ──────────────────────────────────────────
# Скопируй в .env:
#   cp .env.example .env
#
# Большинство переменных жёстко заданы в docker-compose.yml.
# Ниже — то что нужно/можно заполнить вручную.

# ── Администратор Zulip ──────────────────────────────────────────
ZULIP_ADMIN_EMAIL=a.stepanov@2035.university
ZULIP_ADMIN_PASSWORD=legion-admin-2025
# ZULIP_API_KEY — заполняется bootstrap.sh автоматически

# ── Доступ к Zulip API (из контейнера Legion) ────────────────────
# ZULIP_URL — переопределён в docker-compose как https://zulip:443
# Для MCP-серверов и fetchStreamContext
ZULIP_URL=https://zulip
ZULIP_EMAIL=a.stepanov@2035.university
ZULIP_API_HOST=legion.zulip.local:8443    # Host header для subdomain routing

# ── S3 (MinIO) — для MCP-серверов и per-bot конфигов ────────────
# S3_ENDPOINT переопределён в docker-compose как http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=legion-bots

# ── URL для вебхуков создаваемых ботов ───────────────────────────
# Используется в create_bot как payload_url
# legion.local — статический IP 172.18.0.10 (см. docker-compose)
LEGION_PAYLOAD_URL=http://legion.local:3000/webhook/zulip

# ── Модель по умолчанию для новых ботов ─────────────────────────
# Если create_bot вызывается без model, используется эта
DEFAULT_MODEL=opencode-go/deepseek-v4-flash
